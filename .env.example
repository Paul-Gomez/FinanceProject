DB_NAME=fincore
DB_USER=fincore
DB_PASSWORD=change-me
# Obligatorio, al menos 32 caracteres. Por ejemplo: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Puertos publicados en tu equipo. Cámbialos si ya están ocupados (por ejemplo, por otro PostgreSQL).
DB_HOST_PORT=5432
APP_PORT=8080
# Puerto de la web (React servida por nginx)
WEB_PORT=3000
