{
  "name": "fincore-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SPA de React para la API de FinCore",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
